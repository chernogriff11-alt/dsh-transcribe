{
  "name": "@local/dsh-transcribe",
  "version": "0.1.0",
  "private": true,
  "description": "Голосовой ввод в композер DSH: микрофон рядом с отправкой, панель записи, локальный Parakeet Ultra",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "license": "MIT"
}
